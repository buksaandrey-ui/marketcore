# ==============================
# MarketCore — переменные окружения
# Скопируй этот файл в .env и заполни значения
# НИКОГДА не коммить .env в git!
# ==============================

# База данных PostgreSQL
POSTGRES_DB=marketcore_dev
POSTGRES_USER=marketcore
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql://marketcore:devpassword@localhost:5432/marketcore_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=marketcore

# JWT (секретный ключ — замени на случайную строку в продакшене)
JWT_SECRET_KEY=change-me-to-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Шифрование API-ключей (для хранения токенов WB/Ozon)
ENCRYPTION_KEY=change-me-to-32-bytes-key

# API Wildberries
WB_API_BASE_URL=https://suppliers-api.wildberries.ru

# API Ozon
OZON_API_BASE_URL=https://api-seller.ozon.ru

# Окружение
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
